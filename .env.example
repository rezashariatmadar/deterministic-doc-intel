# ==============================================================================
# Production-Grade Hybrid & Agentic RAG Platform Configuration
# ==============================================================================

# Application Settings
APP_NAME="Hybrid & Agentic RAG Platform"
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rag_db
REDIS_URL=redis://localhost:6379/0

# Embedding Provider Configuration
# Supported options: "local", "openai", "gemini"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# LLM Provider Configuration
# Supported options: "local", "openai", "gemini"
LLM_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=mistral

# Cloud Provider API Keys (optional if using local provider)
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Ingestion & Chunking Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retrieval Settings
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
